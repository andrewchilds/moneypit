// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  ASSET      // Checking, Savings, Cash
  LIABILITY  // Credit cards, Loans
  EQUITY     // Opening balances, Retained earnings
  INCOME     // Salary, Interest, Sales
  EXPENSE    // All spending categories
}

enum TransactionStatus {
  PENDING      // Needs categorization
  CATEGORIZED  // Both sides assigned
}

enum AssetType {
  LIQUID           // Banking - checking, savings, money market
  BROKERAGE        // Taxable investment accounts - capital gains on sale
  ROTH_RETIREMENT  // Roth IRA/401k - contributions accessible, earnings locked
  TAX_DEFERRED     // Traditional IRA, 401(k), 403(b) - fully locked until 59½
}

model Book {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts      Account[]
  transactions  Transaction[]
  taxCategories TaxCategory[]
  taxModules    BookTaxModule[]
  rules         Rule[]
  operationLogs OperationLog[]
  taxDocuments  TaxDocument[]
  taxDocumentFiles TaxDocumentFile[]
  taxFacts      TaxFact[]
  businesses    Business[]
}

// A sole-proprietor business within a book. Tax modules marked perBusiness
// (Schedule C) ask their questions once per business, and the tax report
// shows a section per business built from the accounts assigned to it.
model Business {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name      String   // "Freelance design", "Etsy shop"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     BusinessAccount[]
  taxFacts     TaxFact[]
  taxDocuments TaxDocument[]

  @@unique([bookId, name])
  @@index([bookId])
}

// An account attached to a business with the percentage of it the business
// claims: 100 for an account that is wholly the business's, less for a
// personal account used partly for it (a phone). An account can be attached
// to several businesses.
model BusinessAccount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  percent    Decimal  @db.Decimal(5, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, accountId])
  @@index([accountId])
}

model Account {
  id             String      @id @default(cuid())
  bookId         String
  book           Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type           AccountType
  assetType      AssetType?  // Only for ASSET accounts - liquidity classification
  path           String      // "Business:Hosting", "Chase Checking" (no type prefix)
  last4          String?     // Last 4 digits of account number
  openingBalance Decimal?    @db.Decimal(12, 2) // Starting balance before any transactions
  taxCategoryId  String?
  taxCategory    TaxCategory? @relation(fields: [taxCategoryId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([bookId, type, path])
  @@index([bookId])

  debitTransactions  Transaction[] @relation("DebitAccount")
  creditTransactions Transaction[] @relation("CreditAccount")
  rules              Rule[]
  balanceRecords     BalanceRecord[]
  taxDocuments       TaxDocument[]
  businesses         BusinessAccount[]
}

model BalanceRecord {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime
  balance   Decimal  @db.Decimal(12, 2) // Statement balance as of this date
  createdAt DateTime @default(now())

  @@unique([accountId, date])
  @@index([accountId])
}

model Transaction {
  id              String            @id @default(cuid())
  bookId          String
  book            Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  memo            String?
  amount          Decimal           @db.Decimal(12, 2) // Always positive
  debitAccountId  String?           // Money going TO (null = pending categorization)
  debitAccount    Account?          @relation("DebitAccount", fields: [debitAccountId], references: [id])
  creditAccountId String?           // Money coming FROM (null = pending categorization)
  creditAccount   Account?          @relation("CreditAccount", fields: [creditAccountId], references: [id])
  status          TransactionStatus @default(PENDING)
  importSource    String?           // "chase-checking-2025-03.csv"
  importHash      String?           // For deduplication
  mergedIntoId    String?           @map("merged_into_id") // If set, this tx was merged into another
  mergedInto      Transaction?      @relation("MergedTransactions", fields: [mergedIntoId], references: [id])
  mergedFrom      Transaction[]     @relation("MergedTransactions") // Txs that were merged into this one
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  dismissedDupes1 DismissedDuplicate[] @relation("DismissedTx1")
  dismissedDupes2 DismissedDuplicate[] @relation("DismissedTx2")

  @@unique([bookId, importHash])
  @@index([bookId])
  @@index([mergedIntoId])
}

// Tracks pairs of transactions that the user has confirmed are NOT duplicates
model DismissedDuplicate {
  id        String      @id @default(cuid())
  tx1Id     String
  tx2Id     String
  tx1       Transaction @relation("DismissedTx1", fields: [tx1Id], references: [id], onDelete: Cascade)
  tx2       Transaction @relation("DismissedTx2", fields: [tx2Id], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([tx1Id, tx2Id])
  @@index([tx1Id])
  @@index([tx2Id])
}

model TaxCategory {
  id          String    @id @default(cuid())
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name        String    // "Home Office", "Business Travel"
  description String?
  scheduleRef String?   // "Schedule C Line 25", "Schedule A"
  year        Int?      // Tax rules change by year
  moduleId    String?   // Which module created this (null = user-created)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([bookId])

  accounts      Account[]
  documentLines TaxDocumentLine[]
}

enum TaxDocumentStatus {
  RECEIVED        // Form is in hand; its lines are authoritative figures
  NOT_APPLICABLE  // Expected form will not arrive (no activity, etc.)
}

// A tax form received for a year: W-2, 1099-INT, 1098, 1095-A, etc.
// Its lines are the authoritative figures for the tax categories they map to.
model TaxDocument {
  id        String            @id @default(cuid())
  bookId    String
  book      Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  year      Int
  formType  String            // "1098", "1099-B", "W-2"
  issuer    String            // Institution or employer that issued it
  status    TaxDocumentStatus @default(RECEIVED)
  accountId String?           // Account the form reports on, if any
  account   Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  businessId String?          // Business the form belongs to (1099-NEC, 1099-K)
  business  Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  notes     String?
  fileId    String?           // The form itself, possibly shared with other documents
  file      TaxDocumentFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lines TaxDocumentLine[]

  @@index([bookId, year])
  @@index([fileId])
}

// The scanned or downloaded form itself (PDF or image), kept in the database
// so backups and book exports carry it. One file can hold several forms (a
// broker's consolidated 1099 carries a 1099-DIV, a 1099-INT and a 1099-B), so
// any number of documents point at it; it is deleted when the last one lets go.
model TaxDocumentFile {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String   // "application/pdf", "image/png", "image/jpeg"
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  documents TaxDocument[]

  @@index([bookId])
}

model TaxDocumentLine {
  id            String       @id @default(cuid())
  documentId    String
  document      TaxDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  box           String       // "1", "1a", "10"
  label         String
  amount        Decimal      @db.Decimal(12, 2)
  taxCategoryId String?
  taxCategory   TaxCategory? @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  // Where on the attached file the figure was read from: 1-based page and a
  // rectangle as fractions of the page size, so it renders at any zoom.
  page          Int?
  x             Float?
  y             Float?
  w             Float?
  h             Float?
  createdAt     DateTime     @default(now())

  @@index([documentId])
  @@index([taxCategoryId])
}

// A fact about a tax year that doesn't map to a transaction: filing status,
// whether an extension was filed, Roth basis, property use. Keys come from
// the questions declared by enabled tax modules, but any key is allowed.
// year is null for facts that carry forward across years. businessId is set
// for answers to per-business module questions (one answer per business).
model TaxFact {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  year       Int?
  key        String
  value      Json
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([bookId, year, key, businessId])
  @@index([bookId])
}

model BookTaxModule {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  moduleId  String   // e.g., "us-schedule-c"
  enabledAt DateTime @default(now())

  @@unique([bookId, moduleId])
  @@index([bookId])
}

model Rule {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pattern     String   // Regex or substring pattern
  accountId   String   // Account to assign
  account     Account  @relation(fields: [accountId], references: [id])
  field       String   @default("description") // Which field to match
  priority    Int      @default(0) // Higher = checked first
  isRegex     Boolean  @default(false)

  amountMin   Decimal? @db.Decimal(12, 2)  // Amount >= this value
  amountMax   Decimal? @db.Decimal(12, 2)  // Amount <= this value
  amountExact Decimal? @db.Decimal(12, 2)  // Amount == this value (overrides min/max)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookId])
}

model OperationLog {
  id          String    @id @default(cuid())
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  operation   String    // "CREATE", "UPDATE", "DELETE", "CATEGORIZE", "MERGE", "IMPORT", "UNDO"
  description String    // Human-readable: "Categorized 5 transactions as Business:Hosting"
  changes     Json      // [{ entityType, entityId, before, after }]
  undoneAt    DateTime? // Set when this operation is undone (informational)
  createdAt   DateTime  @default(now())

  @@index([bookId])
  @@index([createdAt])
}
